jsFunc Js.tip=tip
jsFunc Js.tipInner=tipInner
jsFunc Js.tipHTML=tipHTML
jsFunc Js.clearTooltips=clearTooltips
benignEffectful Js.tip
benignEffectful Js.tipInner
benignEffectful Js.tipHTML
benignEffectful Js.clearTooltips
script /logitext/jquery.js
script /logitext/jquery.tipsy.js
script /logitext/ffi.js
allow url /logitext/tipsy.css
ffi js
